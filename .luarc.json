{
  "$schema": "https://githubusercontent.com",
  "runtime": {
    "version": "LuaJIT"
  },
  "diagnostics": {
    "globals": [
      "vim",
      "describe",
      "it",
      "assert",
      "before_each",
      "after_each",
      "pending"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "$VIMRUNTIME"
    ]
  }
}
